/* Task Management — tema oscuro rojo */

* {
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow,
QDialog,
QWidget {
    color: #F5F5F5;
    background-color: #0D0D0D;
}

QLabel {
    color: #F5F5F5;
    background: transparent;
}

QFrame#brandPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #250609, stop:0.55 #130D0E, stop:1 #0D0D0D);
    border: 1px solid #4B1519;
    border-radius: 18px;
}

QLabel#brandEyebrowLabel,
QLabel#sectionLabel,
QLabel#pendingCaptionLabel,
QLabel#completedCaptionLabel,
QLabel#overdueCaptionLabel {
    color: #D71920;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#lblAppTitle {
    color: #FFFFFF;
    font-size: 42px;
    font-weight: 800;
}

QLabel#brandDescriptionLabel {
    color: #C6C6C6;
    font-size: 16px;
}

QLabel#versionLabel,
QLabel#formSubtitleLabel,
QLabel#welcomeLabel,
QLabel#hintLabel,
QLabel#statusMessageLabel {
    color: #9D9D9D;
}

QFrame#loginCard,
QFrame#formCard,
QFrame#tableCard,
QFrame#pendingCard,
QFrame#completedCard,
QFrame#overdueCard {
    background-color: #171717;
    border: 1px solid #333333;
    border-radius: 12px;
}

QLabel#formTitleLabel,
QLabel#dialogTitleLabel,
QLabel#dashboardTitleLabel {
    color: #FFFFFF;
    font-size: 27px;
    font-weight: 700;
}

QLabel#errorLabel,
QLabel#statusMessageLabel[error="true"] {
    color: #FF5A61;
}

QFrame#sidebarFrame {
    background-color: #121212;
    border-right: 1px solid #2E2E2E;
}

QFrame#sidebarBrandFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #D71920, stop:1 #A50E14);
    border: 1px solid #FF444B;
    border-radius: 10px;
}

QLabel#sidebarBrandLabel,
QLabel#sidebarBrandSecondLabel {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
}

QLabel#sidebarBrandSecondLabel {
    color: #160305;
}

QLabel#usernameLabel {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 600;
}

QLabel#pendingCountLabel,
QLabel#completedCountLabel,
QLabel#overdueCountLabel {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 700;
}

QLabel#completedCountLabel {
    color: #2EBD75;
}

QLabel#overdueCountLabel {
    color: #F02A32;
}

QLabel#emptyStateLabel {
    color: #8E8E8E;
    min-height: 42px;
}

QPushButton {
    min-height: 38px;
    padding: 0 18px;
    color: #FFFFFF;
    background-color: #D71920;
    border: 1px solid #D71920;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F02A32;
    border-color: #F02A32;
}

QPushButton:pressed {
    background-color: #981117;
    border-color: #981117;
}

QPushButton:disabled {
    color: #707070;
    background-color: #242424;
    border-color: #343434;
}

QPushButton[flat="true"] {
    color: #D8D8D8;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton[flat="true"]:hover {
    color: #FFFFFF;
    background-color: #242424;
    border-color: #383838;
}

QPushButton#allTasksMenuButton,
QPushButton#pendingMenuButton,
QPushButton#inProgressMenuButton,
QPushButton#completedMenuButton {
    min-height: 38px;
    padding: 0 13px;
    color: #C8C8C8;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    text-align: left;
    font-weight: 600;
}

QPushButton#allTasksMenuButton:hover,
QPushButton#pendingMenuButton:hover,
QPushButton#inProgressMenuButton:hover,
QPushButton#completedMenuButton:hover {
    color: #FFFFFF;
    background-color: #291113;
    border-color: #6E2025;
}

QPushButton#allTasksMenuButton:checked,
QPushButton#pendingMenuButton:checked,
QPushButton#inProgressMenuButton:checked,
QPushButton#completedMenuButton:checked {
    color: #FFFFFF;
    background-color: #D71920;
    border-color: #FF4249;
}

QPushButton#logoutButton {
    color: #FFFFFF;
    background-color: #D71920;
    border: 1px solid #FF4249;
    font-weight: 700;
}

QPushButton#logoutButton:hover {
    color: #FFFFFF;
    background-color: #F02A32;
    border-color: #FF666C;
}

QPushButton#toggleSidebarButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    padding: 0;
    color: #FFFFFF;
    background-color: #252525;
    border: 1px solid #454545;
    border-radius: 8px;
}

QPushButton#toggleSidebarButton:hover {
    color: #FFFFFF;
    background-color: #D71920;
    border-color: #FF4249;
}

QPushButton#themeButton {
    color: #F5F5F5;
    background-color: #252525;
    border-color: #454545;
}

QPushButton#themeButton:hover {
    color: #FFFFFF;
    background-color: #3A181B;
    border-color: #D71920;
}

QPushButton#deleteTaskButton {
    background-color: transparent;
    color: #FF5A61;
    border-color: #7A2428;
}

QPushButton#deleteTaskButton:hover {
    background-color: #4A1518;
}

QPushButton#editTaskButton,
QPushButton#refreshButton {
    background-color: #252525;
    border-color: #3A3A3A;
}

QPushButton#editTaskButton:hover,
QPushButton#refreshButton:hover {
    background-color: #333333;
    border-color: #4B4B4B;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QDateTimeEdit,
QComboBox {
    min-height: 38px;
    padding: 0 11px;
    color: #F5F5F5;
    background-color: #1B1B1B;
    border: 1px solid #3A3A3A;
    border-radius: 7px;
    selection-background-color: #8F1015;
}

QTextEdit,
QPlainTextEdit {
    padding: 9px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDateTimeEdit:focus,
QComboBox:focus {
    border: 1px solid #D71920;
}

QLineEdit:disabled,
QComboBox:disabled {
    color: #777777;
    background-color: #161616;
}

QDateTimeEdit[readOnly="true"] {
    color: #F5F5F5;
    background-color: #1B1B1B;
    border: 1px solid #3A3A3A;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    color: #F5F5F5;
    background-color: #1B1B1B;
    border: 1px solid #3A3A3A;
    selection-background-color: #8F1015;
    outline: none;
}

QCheckBox {
    spacing: 8px;
    color: #D8D8D8;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #1B1B1B;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #D71920;
    border-color: #F02A32;
}

QTableWidget {
    color: #F5F5F5;
    background-color: #171717;
    alternate-background-color: #1B1B1B;
    border: none;
    gridline-color: #303030;
    selection-background-color: #4A1518;
    selection-color: #FFFFFF;
    outline: none;
}

QTableWidget::item {
    min-height: 42px;
    padding: 7px;
    border-bottom: 1px solid #292929;
}

QHeaderView::section {
    padding: 10px;
    color: #BEBEBE;
    background-color: #202020;
    border: none;
    border-right: 1px solid #303030;
    border-bottom: 1px solid #343434;
    font-weight: 600;
}

QStatusBar {
    color: #A9A9A9;
    background-color: #111111;
    border-top: 1px solid #252525;
}

QScrollBar:vertical {
    width: 10px;
    background: #151515;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #484848;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #D71920;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QCalendarWidget QWidget {
    background-color: #1B1B1B;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #F5F5F5;
    background-color: #1B1B1B;
    selection-background-color: #D71920;
}

QToolTip {
    color: #F5F5F5;
    background-color: #232323;
    border: 1px solid #D71920;
    padding: 5px;
}
